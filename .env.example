# Chat model provider. Use the provider's actual model identifier.
CHAT_PROVIDER=stub
CHAT_BASE_URL=https://api.example.com/v1
CHAT_MODEL=your-chat-model
CHAT_API_KEY=replace-me

# Local lexical reranking is the default. Set siliconflow to enable remote reranking.
RERANK_PROVIDER=lexical
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=

# Request budget used by the conversation layer.
TOKEN_BUDGET=2000

# Local application: http://127.0.0.1:19530; Compose uses http://milvus:19530.
MILVUS_URI=
MILVUS_COLLECTION=

# Select openai-compatible and dimension 1024 for BAAI/bge-m3.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=64

