# Select stub or openai-compatible. Stub keeps local tests deterministic.
CHAT_PROVIDER=stub

# Chat model provider. Use the provider's actual model identifier.
CHAT_BASE_URL=https://api.example.com/v1
CHAT_MODEL=your-chat-model
CHAT_API_KEY=replace-me

# Request budget used by the conversation layer.
TOKEN_BUDGET=2000

# Optional metadata-only observability export. Leave the URL empty to keep
# the default in-memory recorder. The exporter never sends conversation text.
OBSERVABILITY_EXPORT_URL=
OBSERVABILITY_API_KEY=
OBSERVABILITY_SERVICE_NAME=cartpilot
OBSERVABILITY_TIMEOUT_SECONDS=1.0
OBSERVABILITY_QUEUE_SIZE=1000
