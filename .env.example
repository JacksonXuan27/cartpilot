# Chat model provider. Use the provider's actual model identifier.
CHAT_BASE_URL=https://api.example.com/v1
CHAT_MODEL=your-chat-model
CHAT_API_KEY=replace-me

# Local lexical reranking is the default. Set siliconflow to enable remote reranking.
RERANK_PROVIDER=lexical
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=

# Request budget used by the conversation layer.
TOKEN_BUDGET=2000

