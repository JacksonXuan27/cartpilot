# Select stub or openai-compatible. Stub keeps local tests deterministic.
CHAT_PROVIDER=stub

# Chat model provider. Use the provider's actual model identifier.
CHAT_BASE_URL=https://api.example.com/v1
CHAT_MODEL=your-chat-model
CHAT_API_KEY=replace-me

# Request budget used by the conversation layer.
TOKEN_BUDGET=2000

# Embedding provider and Milvus collection dimension must stay aligned.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBED_API_KEY=
EMBEDDING_DIMENSION=64
MILVUS_URI=http://milvus:19530
MILVUS_COLLECTION=cartpilot_chunks

# Use lexical locally, or siliconflow with RERANK_API_KEY for remote ranking.
RERANK_PROVIDER=lexical
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=

# Optional Langfuse export. All three values are required to enable it.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000

# Optional generic metadata-only HTTP export used when Langfuse is not configured.
OBSERVABILITY_EXPORT_URL=
OBSERVABILITY_API_KEY=
OBSERVABILITY_SERVICE_NAME=cartpilot
OBSERVABILITY_TIMEOUT_SECONDS=1.0
OBSERVABILITY_QUEUE_SIZE=1000
